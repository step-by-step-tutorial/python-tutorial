# ==============================================================================
# Project
# ==============================================================================
TESTDATA_PLATFORM_IMAGE=samanalishiri/testdata-platform:latest
TESTDATA_PLATFORM_API_PORT=8084
COMPOSE_PROJECT_NAME=test
# ==============================================================================
# Database
# ==============================================================================
DATABASE_IMAGE=postgres:16
TESTDATA_PLATFORM_DATABASE_HOST=database
DATABASE_CONTAINER_NAME=database
TESTDATA_PLATFORM_DATABASE_PORT=5432
TESTDATA_PLATFORM_DATABASE_NAME=app_database
TESTDATA_PLATFORM_DATABASE_USER=admin
TESTDATA_PLATFORM_DATABASE_PASSWORD=admin
DATABASE_VOLUME=database_data
# ==============================================================================
# Adminer
# ==============================================================================
ADMINER_IMAGE=adminer
ADMINER_HOST=database-ui
ADMINER_CONTAINER_NAME=database-ui
ADMINER_PORT=8083
