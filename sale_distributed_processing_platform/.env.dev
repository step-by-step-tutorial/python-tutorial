# ==============================================================================
# Project
# ==============================================================================
COMPOSE_PROJECT_NAME=dev

# ==============================================================================
# Application
# ==============================================================================
APPLICATION_IMAGE=samanalishiri/application:latest
APPLICATION_CONTAINER_NAME=application
APPLICATION_HOST=application

APPLICATION_RESOURCES_DIR=/app/resources
APPLICATION_OUTPUT_DIR=/app/output
APPLICATION_SCRIPTS_DIR=/app/scripts
APPLICATION_SPARK_DIR=/app/spark
APPLICATION_DATA_FILE=data.csv

# ==============================================================================
# PostgreSQL
# ==============================================================================
POSTGRES_IMAGE=postgres:16
POSTGRES_HOST=database
POSTGRES_CONTAINER_NAME=database

POSTGRES_PORT=5432
POSTGRES_DATABASE=sale_database
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

POSTGRES_VOLUME=database_data

AIRFLOW_POSTGRES_HOST=airflow-database
AIRFLOW_POSTGRES_CONTAINER_NAME=airflow-database
AIRFLOW_POSTGRES_DATABASE=sale_airflow
AIRFLOW_POSTGRES_VOLUME=airflow_database_data
AIRFLOW_POSTGRES_PORT=5433
AIRFLOW_POSTGRES_USER=admin
AIRFLOW_POSTGRES_PASSWORD=admin
# ==============================================================================
# Adminer
# ==============================================================================
ADMINER_IMAGE=adminer
ADMINER_HOST=database-ui
ADMINER_CONTAINER_NAME=database-ui

ADMINER_PORT=8083

# ==============================================================================
# MinIO
# ==============================================================================
MINIO_IMAGE=minio/minio:latest
MINIO_HOST=datalake
MINIO_CONTAINER_NAME=datalake

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=administrator

MINIO_BUCKET_NAME=sale-datalake

MINIO_VOLUME=datalake_data

# ==============================================================================
# MinIO Client
# ==============================================================================
MINIO_CLIENT_IMAGE=minio/mc:latest
MINIO_CLIENT_HOST=datalake-init
MINIO_CLIENT_CONTAINER_NAME=datalake-init

# ==============================================================================
# ClickHouse
# ==============================================================================
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:latest
CLICKHOUSE_HOST=datawarehouse
CLICKHOUSE_CONTAINER_NAME=datawarehouse

CLICKHOUSE_HTTP_PORT=8123

CLICKHOUSE_DATABASE=sale_datawarehouse
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

CLICKHOUSE_VOLUME=datawarehouse_data

# ==============================================================================
# Apache Spark
# ==============================================================================
SPARK_IMAGE=samanalishiri/spark-4-java21-python3:latest
SPARK_DOCKERFILE=spark/Dockerfile

SPARK_MASTER_CONTAINER_NAME=master
SPARK_MASTER_HOST=master
SPARK_MASTER_RPC_PORT=7077
SPARK_MASTER_UI_PORT=8080

SPARK_WORKER_CONTAINER_NAME=worker
SPARK_WORKER_HOST=worker
SPARK_WORKER_UI_PORT=8081

SPARK_APPLICATION_NAME=SALE_DISTRIBUTED_PROCESSING_PLATFORM
SPARK_MASTER_URL=spark://master:7077
SPARK_DRIVER_HOST=application
SPARK_DRIVER_BIND_ADDRESS=0.0.0.0

# ==============================================================================
# Database Connection
# ==============================================================================
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=sale_database
DATABASE_USER=admin
DATABASE_PASSWORD=admin
DATABASE_DRIVER=org.postgresql.Driver

DATABASE_JDBC_URL=jdbc:postgresql://database:5432/sale_database
DATABASE_SQLALCHEMY_URL=postgresql+psycopg2://admin:admin@database:5432/sale_database

# ==============================================================================
# Data Lake Connection
# ==============================================================================
DATALAKE_ENDPOINT=http://datalake:9000
DATALAKE_ACCESS_KEY=admin
DATALAKE_SECRET_KEY=administrator
DATALAKE_BUCKET_NAME=sale-datalake
DATALAKE_SCHEME=s3a
DATALAKE_ENVIRONMENT=dev
DATALAKE_SALE_DATASET=sale

# ==============================================================================
# Data Warehouse Connection
# ==============================================================================
DATAWAREHOUSE_HOST=datawarehouse
DATAWAREHOUSE_PORT=8123
DATAWAREHOUSE_NAME=sale_datawarehouse
DATAWAREHOUSE_USER=admin
DATAWAREHOUSE_PASSWORD=admin

# ==============================================================================
# Apache Airflow
# ==============================================================================
AIRFLOW_IMAGE=apache/airflow:slim-3.3.0-python3.12
AIRFLOW_CONTAINER_NAME=airflow
AIRFLOW_HOST=airflow
AIRFLOW_PORT=8082

AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_SIMPLE_AUTH_MANAGER_USERS=admin:admin

AIRFLOW_DATABASE_NAME=sale_airflow
AIRFLOW_DATABASE_SQLALCHEMY_URL=postgresql+psycopg2://admin:admin@airflow-database:5432/sale_airflow
AIRFLOW_DATABASE_SQLALCHEMY_URL_ASYNC=postgresql+asyncpg://admin:admin@airflow-database:5432/sale_airflow

AIRFLOW_PYTHONPATH=/app/src
AIRFLOW_DAGS_DIR=/opt/airflow/dags
AIRFLOW_SRC_DIR=/app/src
AIRFLOW_PLUGINS_DIR=/opt/airflow/plugins
AIRFLOW_RESOURCES_DIR=/app/resources
AIRFLOW_OUTPUT_DIR=/app/output
AIRFLOW_SCRIPTS_DIR=/app/scripts
AIRFLOW_REQUIREMENTS_FILE=/app/requirements.txt
AIRFLOW_PASSWORD_FILE=/opt/airflow/simple_auth_manager_passwords.json.generated

# ==============================================================================
# Kafka
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=sale-events

# ==============================================================================
# ML Flow
# ==============================================================================
SALE_MLFLOW_TRACKING_URI=http://localhost:5000

# ==============================================================================
# ML Model
# ==============================================================================
SALE_ML_MODEL_PATH=models/sale_model.joblib
SALE_DL_MODEL_PATH=models/sale_neural_network.pt