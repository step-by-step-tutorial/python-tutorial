{
  "row_count": 5000,
  "output_name": "online_shopping",
  "kafka_topic": "online-shopping-events",
  "kafka_key_column": "order_id",
  "destinations": ["csv", "json", "database", "kafka"],
  "columns": [
    { "name": "order_id", "type": "sequence", "start": 100001, "step": 1 },
    {
      "name": "order_date",
      "type": "random_date",
      "date_start": "2026-01-01",
      "date_end": "2026-06-30"
    },
    { "name": "sales_channel", "type": "random_from_file", "file": "data/sales_channels.txt" },
    { "name": "customer_id", "type": "random_int", "min": 100000, "max": 999999 },
    {
      "name": "first_name",
      "type": "random_from_mapped_file",
      "source_field": "country",
      "mapping_file": "data/country_source_map.csv",
      "key_column": "country",
      "file_column": "first_name_file"
    },
    {
      "name": "last_name",
      "type": "random_from_mapped_file",
      "source_field": "country",
      "mapping_file": "data/country_source_map.csv",
      "key_column": "country",
      "file_column": "last_name_file"
    },
    {
      "name": "email",
      "type": "derived",
      "method": "email_from_source_fields",
      "source_fields": ["first_name", "last_name"],
      "domain": "example-shop.com"
    },
    {
      "name": "phone",
      "type": "random_from_mapped_file",
      "source_field": "country",
      "mapping_file": "data/country_source_map.csv",
      "key_column": "country",
      "file_column": "phone_file"
    },
    {
      "name": "shipping_address",
      "type": "random_from_mapped_file",
      "source_field": "country",
      "mapping_file": "data/country_source_map.csv",
      "key_column": "country",
      "file_column": "address_file"
    },
    { "name": "country", "type": "random_from_file", "file": "data/countries.txt" },
    {
      "name": "currency",
      "type": "derived",
      "method": "lookup_from_csv",
      "source_field": "country",
      "mapping_file": "data/country_profile_map.csv",
      "key_column": "country",
      "value_column": "currency_code"
    },
    {
      "name": "warehouse",
      "type": "random_from_mapped_file",
      "source_field": "country",
      "mapping_file": "data/country_warehouse_map.csv",
      "key_column": "country",
      "file_column": "warehouse_file"
    },
    { "name": "product_name", "type": "random_from_file", "file": "data/product_names.txt" },
    {
      "name": "category",
      "type": "derived",
      "method": "lookup_from_csv",
      "source_field": "product_name",
      "mapping_file": "data/product_catalog.csv",
      "key_column": "product",
      "value_column": "category"
    },
    {
      "name": "unit_price",
      "type": "derived",
      "method": "lookup_from_csv",
      "source_field": "product_name",
      "mapping_file": "data/product_catalog.csv",
      "key_column": "product",
      "value_column": "unit_price"
    },
    { "name": "quantity", "type": "random_int", "min": 1, "max": 6 },
    {
      "name": "subtotal",
      "type": "derived",
      "method": "product_of_source_fields",
      "source_fields": ["quantity", "unit_price"]
    },
    { "name": "discount_percent", "type": "random_int", "min": 0, "max": 30 },
    { "name": "shipping_cost", "type": "random_int", "min": 5, "max": 25 },
    {
      "name": "tax_amount",
      "type": "derived",
      "method": "product_of_source_fields",
      "source_fields": ["subtotal"],
      "value": 0.1
    },
    {
      "name": "total_amount",
      "type": "derived",
      "method": "formula",
      "source_fields": ["subtotal", "discount_percent", "shipping_cost", "tax_amount"],
      "formula": "values[0] - values[0] * values[1] / 100 + values[2] + values[3]"
    },
    { "name": "payment_status", "type": "random_from_file", "file": "data/payment_statuses.txt" },
    { "name": "fulfillment_status", "type": "random_from_file", "file": "data/fulfillment_statuses.txt" },
    {
      "name": "estimated_delivery_date",
      "type": "derived",
      "method": "date_with_random_day_offset",
      "source_field": "order_date",
      "start": 2,
      "step": 10
    },
    { "name": "coupon_code", "type": "random_from_file", "file": "data/coupon_codes.txt" },
    { "name": "payment_method", "type": "random_from_file", "file": "data/payment_methods.txt" },
    { "name": "shipping_method", "type": "random_from_file", "file": "data/shipping_methods.txt" },
    { "name": "delivery_days", "type": "random_int", "min": 1, "max": 10 },
    { "name": "order_status", "type": "random_from_file", "file": "data/order_statuses.txt" }
  ]
}
