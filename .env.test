# ==============================================================================
# Project
# ==============================================================================
COMPOSE_PROJECT_NAME=test
# ==============================================================================
# Database
# ==============================================================================
DATABASE_IMAGE=postgres:16
APP_DATABASE_HOST=database
DATABASE_CONTAINER_NAME=database
APP_DATABASE_PORT=5432
APP_DATABASE_NAME=app_database
APP_DATABASE_USER=admin
APP_DATABASE_PASSWORD=admin
DATABASE_VOLUME=database_data
# ==============================================================================
# Airflow Database
# ==============================================================================
AIRFLOW_DATABASE_CONTAINER_NAME=airflow-database
AIRFLOW_DATABASE_HOST=airflow-database
AIRFLOW_DATABASE_NAME=sale_airflow
AIRFLOW_DATABASE_PORT=5433
AIRFLOW_DATABASE_USER=admin
AIRFLOW_DATABASE_PASSWORD=admin
AIRFLOW_DATABASE_VOLUME=airflow_database_data
# ==============================================================================
# Adminer
# ==============================================================================
ADMINER_IMAGE=adminer
ADMINER_HOST=database-ui
ADMINER_CONTAINER_NAME=database-ui
ADMINER_PORT=8500
# ==============================================================================
# Data Lake
# ==============================================================================
DATALAKE_IMAGE=minio/minio:latest
DATALAKE_HOST=datalake
DATALAKE_CONTAINER_NAME=datalake
DATALAKE_API_PORT=9000
DATALAKE_CONSOLE_PORT=9001
APP_DATALAKE_ACCESS_KEY=admin
APP_DATALAKE_SECRET_KEY=administrator
APP_DATALAKE_BUCKET_NAME=app-datalake
APP_DATALAKE_AUDIT_BUCKET_NAME=app-datalake-audit
DATALAKE_VOLUME=datalake_data
# ==============================================================================
# Data Lake Client
# ==============================================================================
DATALAKE_CLIENT_IMAGE=minio/mc:latest
DATALAKE_CLIENT_HOST=datalake-init
DATALAKE_CLIENT_CONTAINER_NAME=datalake-init
# ==============================================================================
# Data Warehouse
# ==============================================================================
DATAWAREHOUSE_IMAGE=clickhouse/clickhouse-server:latest
APP_DATAWAREHOUSE_HOST=datawarehouse
DATAWAREHOUSE_CONTAINER_NAME=datawarehouse
DATAWAREHOUSE_HTTP_PORT=8123
APP_DATAWAREHOUSE_NAME=app_datawarehouse
APP_DATAWAREHOUSE_USER=admin
APP_DATAWAREHOUSE_PASSWORD=admin
DATAWAREHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
DATAWAREHOUSE_VOLUME=datawarehouse_data
# ==============================================================================
# Apache Spark
# ==============================================================================
SPARK_IMAGE=samanalishiri/spark-4-java21-python3:latest
SPARK_DOCKERFILE=spark/Dockerfile
SPARK_MASTER_CONTAINER_NAME=master
SPARK_MASTER_HOST=master
SPARK_MASTER_RPC_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_CONTAINER_NAME=worker
SPARK_WORKER_HOST=worker
SPARK_WORKER_UI_PORT=8081
SPARK_APPLICATION_NAME=data_platform
SPARK_MASTER_URL=spark://master:7077
SPARK_DRIVER_HOST=application
SPARK_DRIVER_BIND_ADDRESS=0.0.0.0
# ==============================================================================
# Application
# ==============================================================================
APPLICATION_IMAGE=samanalishiri/application:latest
APPLICATION_CONTAINER_NAME=application
APPLICATION_HOST=application
ROOT=/app
APPLICATION_RESOURCES_DIR=/app/resources
APPLICATION_OUTPUT_DIR=/app/output
APPLICATION_SCRIPTS_DIR=/app/scripts
APPLICATION_SPARK_DIR=/app/spark
APPLICATION_DATA_FILE=data.csv
