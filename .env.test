# ==============================================================================
# Sale Messaging Connection
# ==============================================================================
DATA_PLATFORM_SALE_STREAMING_BOOTSTRAP_SERVERS=kafka:9094
DATA_PLATFORM_SALE_CHANNEL_NAME=sale-events
DATA_PLATFORM_SALE_AUDIT_CHANNEL_NAME=sale.audit.event.v1
# ==============================================================================
# House Messaging Connection
# ==============================================================================
DATA_PLATFORM_HOUSE_STREAMING_BOOTSTRAP_SERVERS=kafka:9094
DATA_PLATFORM_HOUSE_CHANNEL_NAME=house.events.v1
DATA_PLATFORM_HOUSE_AUDIT_CHANNEL_NAME=house.audit.events.v1
# ==============================================================================
# Audit Messaging Connection
# ==============================================================================
DATA_PLATFORM_AUDIT_STREAMING_BOOTSTRAP_SERVERS=kafka:9094
DATA_PLATFORM_AUDIT_STREAM_CHANNEL_NAME=audit.events.v1
# ==============================================================================
# Test data
# ==============================================================================
DATA_SIMULATOR_API_URL=http://test-data:8080
TEST_DATA_IMAGE=samanalishiri/test-data:latest
TEST_DATA_HOST=test-data
TEST_DATA_CONTAINER_NAME=test-data
TEST_DATA_API_PORT=8084
TEST_DATA_DATABASE_HOST=database
TEST_DATA_DATABASE_NAME=app_database
TEST_DATA_DATABASE_USER=admin
TEST_DATA_DATABASE_PASSWORD=admin
TEST_DATA_DATABASE_PORT=5432
# ==============================================================================
# Apache Airflow
# ==============================================================================
AIRFLOW_IMAGE=samanalishiri/data-platform-airflow:latest
AIRFLOW_CONTAINER_NAME=airflow
AIRFLOW_HOST=airflow
AIRFLOW_PORT=8082
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW_DATABASE_SQLALCHEMY_URL=postgresql+psycopg2://admin:admin@airflow-database:5432/sale_airflow
AIRFLOW_DATABASE_SQLALCHEMY_URL_ASYNC=postgresql+asyncpg://admin:admin@airflow-database:5432/sale_airflow
AIRFLOW_PYTHONPATH=/app/src
AIRFLOW_DAGS_DIR=/opt/airflow/dags
AIRFLOW_SRC_DIR=/app/src
AIRFLOW_PLUGINS_DIR=/opt/airflow/plugins
AIRFLOW_RESOURCES_DIR=/app/resources
AIRFLOW_OUTPUT_DIR=/app/output
AIRFLOW_SCRIPTS_DIR=/app/scripts
AIRFLOW_REQUIREMENTS_FILE=/app/requirements.txt
AIRFLOW_PASSWORD_FILE=/opt/airflow/simple_auth_manager_passwords.json.generated
# ==============================================================================
# Streaming
# ==============================================================================
DATA_PLATFORM_AUDIT_CHANNEL_NAME=audit.audit.events.v1
DATA_PLATFORM_SALE_STREAMING_STARTING_OFFSETS=earliest
DATA_PLATFORM_HOUSE_STREAMING_STARTING_OFFSETS=earliest
DATA_PLATFORM_AUDIT_STREAMING_STARTING_OFFSETS=earliest
DATA_PLATFORM_DATALAKE_CHECKPOINT_PATH=s3a://app-datalake/checkpoints/events
DATA_PLATFORM_SALE_DATALAKE_CHECKPOINT_PATH=s3a://app-datalake/checkpoints/sale-events
DATA_PLATFORM_HOUSE_DATALAKE_CHECKPOINT_PATH=s3a://app-datalake/checkpoints/house.events.v1
DATA_PLATFORM_AUDIT_DATALAKE_CHECKPOINT_PATH=s3a://app-datalake/checkpoints/audit.events.v1
SPARK_BUFFER=array
SPARK_ACTIVE_BLOCKS=1
SPARK_THREADS_MAX=4
SPARK_MAX_TOTAL_TASKS=4
MAX_DIRECT_MEMORY_SIZE=2g

