# ==============================================================================
# Project
# ==============================================================================
COMPOSE_PROJECT_NAME=test
# ==============================================================================
# Data Platform
# ==============================================================================
DATASET_NAME=sale
PIPELINE_TYPE=inmemory_auditable
# ==============================================================================
# Database
# ==============================================================================
DATABASE_IMAGE=postgres:16
DATA_PLATFORM_DATABASE_HOST=database
DATABASE_CONTAINER_NAME=database
DATA_PLATFORM_DATABASE_PORT=5432
DATA_PLATFORM_DATABASE_NAME=app_database
DATA_PLATFORM_DATABASE_USER=admin
DATA_PLATFORM_DATABASE_PASSWORD=admin
DATABASE_VOLUME=database_data
# ==============================================================================
# Airflow Database
# ==============================================================================
AIRFLOW_DATABASE_CONTAINER_NAME=airflow-database
AIRFLOW_DATABASE_HOST=airflow-database
AIRFLOW_DATABASE_NAME=sale_airflow
AIRFLOW_DATABASE_PORT=5433
AIRFLOW_DATABASE_USER=admin
AIRFLOW_DATABASE_PASSWORD=admin
AIRFLOW_DATABASE_VOLUME=airflow_database_data
# ==============================================================================
# Adminer
# ==============================================================================
ADMINER_IMAGE=adminer
ADMINER_HOST=database-ui
ADMINER_CONTAINER_NAME=database-ui
ADMINER_PORT=8083
# ==============================================================================
# Data Lake
# ==============================================================================
DATALAKE_IMAGE=minio/minio:latest
DATALAKE_HOST=datalake
DATALAKE_CONTAINER_NAME=datalake
DATALAKE_API_PORT=9000
DATALAKE_CONSOLE_PORT=9001
DATA_PLATFORM_DATALAKE_ACCESS_KEY=admin
DATA_PLATFORM_DATALAKE_SECRET_KEY=administrator
DATA_PLATFORM_DATALAKE_BUCKET_NAME=app-datalake
DATA_PLATFORM_DATALAKE_AUDIT_BUCKET_NAME=app-datalake-audit
DATA_PLATFORM_DATALAKE_BACKUP_BUCKET_NAME=app-datalake-backup
DATALAKE_VOLUME=datalake_data
# ==============================================================================
# Data Lake Client
# ==============================================================================
DATALAKE_CLIENT_IMAGE=minio/mc:latest
DATALAKE_CLIENT_HOST=datalake-init
DATALAKE_CLIENT_CONTAINER_NAME=datalake-init
# ==============================================================================
# Data Warehouse
# ==============================================================================
DATAWAREHOUSE_IMAGE=clickhouse/clickhouse-server:latest
DATA_PLATFORM_DATAWAREHOUSE_HOST=datawarehouse
DATAWAREHOUSE_CONTAINER_NAME=datawarehouse
DATA_PLATFORM_DATAWAREHOUSE_NAME=app_warehouse
DATA_PLATFORM_DATAWAREHOUSE_USER=admin
DATA_PLATFORM_DATAWAREHOUSE_PASSWORD=admin
DATAWAREHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
DATAWAREHOUSE_VOLUME=datawarehouse_data
# ==============================================================================
# Apache Spark
# ==============================================================================
SPARK_IMAGE=samanalishiri/spark-4-java21-python3:latest
SPARK_DOCKERFILE=spark/Dockerfile
SPARK_MASTER_CONTAINER_NAME=master
SPARK_MASTER_HOST=master
SPARK_MASTER_RPC_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_CONTAINER_NAME=worker
SPARK_WORKER_HOST=worker
SPARK_WORKER_UI_PORT=8081
SPARK_APPLICATION_NAME=data_platform
SPARK_MASTER_URL=spark://master:7077
SPARK_DRIVER_HOST=data-platform
SPARK_DRIVER_BIND_ADDRESS=0.0.0.0
# ==============================================================================
# Data Platform
# ==============================================================================
DATA_PLATFORM_IMAGE=samanalishiri/data-platform:latest
DATA_PLATFORM_CONTAINER_NAME=data-platform
DATA_PLATFORM_HOST=data-platform
ROOT=/app
DATA_PLATFORM_RESOURCES_DIR=/app/resources
DATA_PLATFORM_OUTPUT_DIR=/app/output
DATA_PLATFORM_SCRIPTS_DIR=/app/scripts
DATA_PLATFORM_SPARK_DIR=/app/spark
DATA_PLATFORM_DATA_FILE=data.csv
# ==============================================================================
# Database Connection
# ==============================================================================
DATA_PLATFORM_DATABASE_DRIVER=org.postgresql.Driver
DATA_PLATFORM_DATABASE_JDBC_URL=jdbc:postgresql://database:5432/app_database
DATA_PLATFORM_DATABASE_SQLALCHEMY_URL=postgresql+psycopg2://admin:admin@database:5432/app_database
# ==============================================================================
# Sale Database Connection
# ==============================================================================
DATA_PLATFORM_SALE_DATABASE_HOST=database
DATA_PLATFORM_SALE_DATABASE_PORT=5432
DATA_PLATFORM_SALE_DATABASE_NAME=app_database
DATA_PLATFORM_SALE_DATABASE_USER=admin
DATA_PLATFORM_SALE_DATABASE_PASSWORD=admin
DATA_PLATFORM_SALE_DATABASE_DRIVER=org.postgresql.Driver
DATA_PLATFORM_SALE_DATABASE_JDBC_URL=jdbc:postgresql://database:5432/app_database
DATA_PLATFORM_SALE_DATABASE_SQLALCHEMY_URL=postgresql+psycopg2://admin:admin@database:5432/app_database
# ==============================================================================
# House Database Connection
