DATA_PLATFORM_SALE_DATAWAREHOUSE_USER=admin
DATA_PLATFORM_SALE_DATAWAREHOUSE_PASSWORD=admin
DATA_PLATFORM_SALE_DATAWAREHOUSE_JDBC_URL=jdbc:clickhouse://datawarehouse:8123/app_datawarehouse
# ==============================================================================
