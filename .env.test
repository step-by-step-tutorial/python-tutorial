# Sale Messaging Connection
# ==============================================================================
APP_SALE_STREAMING_BOOTSTRAP_SERVERS=kafka:9094
APP_SALE_CHANNEL_NAME=sale-events
APP_SALE_AUDIT_CHANNEL_NAME=sale.audit.event.v1
# ==============================================================================
# House Messaging Connection
# ==============================================================================
APP_HOUSE_STREAMING_BOOTSTRAP_SERVERS=kafka:9094
APP_HOUSE_CHANNEL_NAME=house-events
APP_HOUSE_AUDIT_CHANNEL_NAME=house.audit.event.v1
# ==============================================================================
# Audit Messaging Connection
# ==============================================================================
APP_AUDIT_STREAMING_BOOTSTRAP_SERVERS=kafka:9094
APP_AUDIT_STREAM_CHANNEL_NAME=audit-events
APP_AUDIT_AUDIT_CHANNEL_NAME=sale.audit.event.v1
